{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/lifeline-groups-block",
  "version": "0.1.0",
  "title": "Lifeline Groups Block",
  "category": "widgets",
  "icon": "smiley",
  "description": "Displays product groups for Lifeline.",
  "example": {},
  "attributes": {
    "groupId": {
      "type": "integer"
    },
    "groupName": {
      "type": "string"
    },
    "displayTitle": {
      "type": "boolean",
      "default": true
    },
    "productColumns": {
      "type": "integer",
      "default": 6
    }
  },
  "supports": {
    "html": false,
    "color": {
      "background": false,
      "text": true
    }
  },
  "textdomain": "lifeline-groups-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}